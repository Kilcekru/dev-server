{
	"name": "@kilcekru/dev-server",
	"version": "1.1.0",
	"description": "",
	"license": "MIT",
	"author": {
		"name": "Kilcekru",
		"email": "kilcekru@unkreativ.at"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kilcekru/dev-server.git"
	},
	"homepage": "https://github.com/Kilcekru/dev-server#readme",
	"bugs": "https://github.com/Kilcekru/dev-server/issues",
	"engines": {
		"pnpm": ">=9"
	},
	"files": [
		"dist/**"
	],
	"main": "dist/index.cjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "tsdown --config utils/tsdown.config.mjs",
		"clean": "rm -rf dist",
		"clean:all": "rm -rf dist node_modules",
		"dev": "tsdown --config utils/tsdown.config.mjs --watch",
		"lint": "eslint src",
		"prepack": "pnpm validate && pnpm lint && pnpm build",
		"prepare": "husky utils/husky",
		"prettier": "prettier --write .",
		"validate": "tsc --noEmit"
	},
	"dependencies": {
		"@fastify/middie": "^9.3.2",
		"@fastify/static": "^9.1.3",
		"@fastify/websocket": "^11.2.0",
		"chokidar": "^5.0.0",
		"fastify": "^5.8.5"
	},
	"devDependencies": {
		"@kilcekru/ts-basics": "5.0.0-next.1",
		"@types/node": "^25.9.1",
		"@types/ws": "^8.18.1",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"prettier": "^3.8.3",
		"tsdown": "^0.22.0",
		"typescript": "^6.0.3"
	}
}
